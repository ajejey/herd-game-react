{
  "appId": "com.herdgamesonline.app",
  "appName": "Herd Games",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#FFF8E7"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#FFF8E7",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#3D8B5A"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
